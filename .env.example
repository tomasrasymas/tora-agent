# llama.cpp server (OpenAI-compatible) running on the DGX
TORA_LLM_BASE_URL=http://localhost:8033/v1
# Optional: pin a model id. If unset, the loaded model is auto-detected.
# TORA_MODEL=

# Backend bind address
TORA_HOST=127.0.0.1
TORA_PORT=8000

# Where custom skills + configs live. Defaults to ~/.tora on the host.
# In Docker this is the mount point (/root/.tora) — set via docker-compose.yml.
TORA_HOME=~/.tora

