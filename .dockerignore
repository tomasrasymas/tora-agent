# Git / VCS
.git/
.gitignore

# Secrets & local env (never bake into the image)
.env
.env.local
.env.*.local

# Python caches & virtualenvs
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor / OS cruft
.DS_Store
.idea/
.vscode/
.claude/

# Not needed at runtime — keeps the build context small.
# (README.md is kept: hatchling reads it as the project's `readme`.)
benchmarks/

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore
